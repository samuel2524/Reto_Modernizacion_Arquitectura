@startuml UML-TO-BE
!pragma layout smetana
title UML TO-BE integrado — decisiones ADR-001 a ADR-005

left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 28
skinparam ranksep 42
skinparam dpi 180
skinparam defaultFontSize 11

package "Espacio de nombres global" as Global {
  class Program <<composition root>> #D6EAF8
}

package "BibFarmacia.Interfaces" as Interfaces {
  interface ICargadorProductos <<ADR-002, DIP, ISP>> #F5B7B1
  interface ICargadorClientes <<ADR-002, DIP, ISP>> #F5B7B1
  interface ICargadorUsuarios <<ADR-002, DIP, ISP>> #F5B7B1
  interface ICreadorProducto <<ADR-003, OCP>> #D5F5E3
  interface IDescuento #E5E7EB
  interface IServicioNotificacion #E5E7EB
}

package "BibFarmacia.Servicios" as Servicios {
  class ServicioVenta <<ADR-001, SRP>> #D6EAF8
  class ServicioFidelizacion <<ADR-004, SRP>> #D6EAF8
  class ServicioMonitoreoProductos <<ADR-005, SRP>> #D6EAF8
  class ServicioProducto <<AS-IS intervenido, ADR-002, DIP>> #F5B7B1
  class ServicioCliente <<AS-IS intervenido, ADR-002, DIP>> #F5B7B1
  class ServicioUsuario <<AS-IS intervenido, ADR-002, DIP>> #F5B7B1
  class ServicioMovimiento #E5E7EB
  class ServicioDescuento #E5E7EB
  class ServicioNotificacion #E5E7EB
  class CargadorProductosTxt <<ADR-002/003, DIP>> #F5B7B1
  class CargadorClientesTxt <<ADR-002, DIP>> #F5B7B1
  class CargadorUsuariosTxt <<ADR-002, DIP>> #F5B7B1
}

package "BibFarmacia.Clases" as Clases {
  abstract class Persona #E5E7EB
  class Usuario #E5E7EB
  class Cliente #E5E7EB
  abstract class Producto #E5E7EB
  class Medicamento #E5E7EB
  class MedicamentoCapsula #E5E7EB
  class MedicamentoLiquido #E5E7EB
  class Laboratorio #E5E7EB
  class Movimiento #E5E7EB
  class DatosProducto <<ADR-003, OCP>> #D5F5E3
}

package "BibFarmacia.Factories" as Factories {
  class ProductoFactory <<estática, conservada>> #E5E7EB
  class CreadorMedicamentoCapsula <<ADR-003, OCP>> #D5F5E3
}

package "BibFarmacia.Eventos" as Eventos {
  class EventoStockMinimo #E5E7EB
  class EventoVencimiento #E5E7EB
  class EventoPuntos #E5E7EB
  class EventoMovimiento #E5E7EB
}

package "BibFarmacia.Enum" as Enums {
  enum TipoRelleno #E5E7EB
  enum MaterialEnvase #E5E7EB
}

package "BibFarmacia.Aspectos" as Aspectos {
  class AspectoAutenticacion <<estática>> #E5E7EB
  class AspectoValidacion <<estática>> #E5E7EB
}

Usuario --|> Persona
Cliente --|> Persona
Medicamento --|> Producto
MedicamentoCapsula --|> Medicamento
MedicamentoLiquido --|> Medicamento
ServicioDescuento ..|> IDescuento
ServicioNotificacion ..|> IServicioNotificacion
CargadorProductosTxt ..|> ICargadorProductos
CargadorClientesTxt ..|> ICargadorClientes
CargadorUsuariosTxt ..|> ICargadorUsuarios
CreadorMedicamentoCapsula ..|> ICreadorProducto

ServicioProducto --> "1" ICargadorProductos : <<inyecta>>
ServicioCliente --> "1" ICargadorClientes : <<inyecta>>
ServicioUsuario --> "1" ICargadorUsuarios : <<inyecta>>
CargadorProductosTxt --> "1" ICreadorProducto : <<inyecta>>

ServicioProducto --> "0..*" Producto : <<mantiene>>
ServicioCliente --> "0..*" Cliente : <<mantiene>>
ServicioUsuario --> "0..*" Usuario : <<mantiene>>
ServicioMovimiento --> "0..*" Movimiento : <<mantiene>>

ServicioVenta --> "1" ServicioProducto
ServicioVenta --> "1" ServicioMovimiento
ServicioVenta ..> Movimiento : <<crea>>
ServicioFidelizacion --> "1" EventoPuntos
ServicioFidelizacion ..> Cliente : <<usa>>
ServicioMonitoreoProductos --> "1" EventoStockMinimo
ServicioMonitoreoProductos --> "1" EventoVencimiento
ServicioMonitoreoProductos ..> Producto : <<monitorea>>
ServicioMovimiento --> "1" EventoMovimiento

CargadorProductosTxt ..> DatosProducto : <<crea>>
CargadorClientesTxt ..> Cliente : <<crea>>
CargadorUsuariosTxt ..> Usuario : <<crea>>
CreadorMedicamentoCapsula ..> DatosProducto : <<usa>>
CreadorMedicamentoCapsula ..> MedicamentoCapsula : <<crea>>
CreadorMedicamentoCapsula ..> Laboratorio : <<crea>>
Medicamento --> "1" Laboratorio
Movimiento --> "1" Producto
MedicamentoCapsula ..> TipoRelleno
MedicamentoLiquido ..> MaterialEnvase

Program ..> CargadorProductosTxt : <<crea>>
Program ..> CargadorClientesTxt : <<crea>>
Program ..> CargadorUsuariosTxt : <<crea>>
Program ..> CreadorMedicamentoCapsula : <<crea>>
Program ..> ServicioProducto : <<crea>>
Program ..> ServicioCliente : <<crea>>
Program ..> ServicioUsuario : <<crea>>
Program ..> ServicioMovimiento : <<crea>>
Program ..> ServicioVenta : <<crea>>
Program ..> ServicioFidelizacion : <<crea>>
Program ..> ServicioMonitoreoProductos : <<crea>>
Program ..> EventoStockMinimo : <<se suscribe>>
Program ..> EventoVencimiento : <<se suscribe>>
Program ..> EventoPuntos : <<se suscribe>>
Program ..> EventoMovimiento : <<se suscribe>>

AspectoAutenticacion ..> Usuario
AspectoValidacion ..> Cliente
AspectoValidacion ..> Producto
ProductoFactory ..> MedicamentoCapsula : <<crea>>
ProductoFactory ..> MedicamentoLiquido : <<crea>>
ProductoFactory ..> Laboratorio : <<usa>>

note right of Program
  Program actúa como Composition Root:
  crea implementaciones concretas y conecta las dependencias.
end note

note bottom of ProductoFactory
  Conservada por ADR-003.
  No participa en el flujo de carga adoptado.
end note

legend bottom
  |= Color |= Trazabilidad principal |
  | <back:#E5E7EB>Gris</back> | Tipo o jerarquía AS-IS conservada |
  | <back:#D6EAF8>Azul</back> | SRP: caso de uso o responsabilidad separada |
  | <back:#D5F5E3>Verde</back> | OCP: creación extensible de productos |
  | <back:#FAD7A0>Naranja</back> | LSP: reservado para nota de verificación, no para la jerarquía |
  | <back:#E8DAEF>Morado</back> | ISP cuando sea la motivación principal |
  | <back:#F5B7B1>Rojo</back> | DIP: inversión frente al detalle TXT; ISP se indica como secundario |
  ADR-001: ServicioVenta. ADR-002: puertos y cargadores TXT.
  ADR-003: DatosProducto y creador. ADR-004: ServicioFidelizacion.
  ADR-005: ServicioMonitoreoProductos.
  Las firmas completas están distribuidas en UML-TO-BE-02 a 04.
endlegend

@enduml
