        <mxCell id="D23_l" connectable="0" parent="D23" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=13;labelBackgroundColor=#ffffff;fontFamily=Helvetica;" value="implementa" vertex="1">
          <mxGeometry relative="1" x="0.4217" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="N1" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=18;verticalAlign=top;align=left;fontSize=13;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontFamily=Helvetica;" value="DONDE SE INVIERTE LA RELACION HOY:&amp;nbsp;&lt;br&gt;No existe una inversión efectiva de las dependencias, no se evidencia que el alto nivel ni el detalle dependan de una abstraccion, por el contrario hay acoplamientos de alto nivel hacia detalles técnicos mediante las dependencias directas hacia System.IO.File y AspectoAutenticacion.&lt;div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Para evidenciar mejor la falta de inversión de dependencias incluimos la&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;s flechas rojas (violaciones a DIP) que representan casos en los que el alto nivel va a detalles&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;tecnicos,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;div&gt;Verificado sobre el codigo:&lt;br&gt;1. Los servicios llaman File.ReadAllLines directamente.&lt;br&gt;2. Program escribe a Console y construye todo con new.&lt;br&gt;3. ServicioProducto instancia MedicamentoCapsula, un&lt;br&gt;   tipo concreto, en vez de pedir una abstraccion.&lt;br&gt;4. ServicioUsuario llama a la estatica AspectoAutenticacion.&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="286" width="470" x="1940" y="380" as="geometry" />
        </mxCell>
        <mxCell id="N2" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=18;verticalAlign=top;align=left;fontSize=13;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontFamily=Helvetica;" value="LAS UNICAS ABSTRACCIONES APUNTAN AL VACIO&lt;br&gt;&lt;br&gt;IDescuento e IServicioNotificacion son las dos unicas&lt;br&gt;interfaces del sistema, pero ningún consumidor depende de ellas, solo existen las realizaciones de las implementaciones (ServicioDescuento implementa&lt;br&gt;IDescuento) pero no existe el consumidor. Una abstraccion&lt;br&gt;de la que no depende nadie no invierte nada.&lt;br&gt;&lt;br&gt;Hallazgo H-08 del inventario: Tenemos 4 componentes y 2 interfaces&lt;br&gt;sin ningun consumidor en el flujo real." vertex="1">
          <mxGeometry height="266" width="470" x="1940" y="2060" as="geometry" />
        </mxCell>
        <mxCell id="TITULO" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" value="SolucionFarmacia — Mapa de dependencias AS-IS&#xa;Fase 1 · que clase depende de cuales · alto nivel frente a bajo nivel · donde se invierte la relacion hoy&#xa;Reconstruido y verificado sobre el codigo fuente (BibFarmacia + AppFarmaciaConsola)" vertex="1">
          <mxGeometry height="100" width="1600" x="60" y="40" as="geometry" />
        </mxCell>
