        <mxCell id="OLD_S10_l" value="crea, registra e inyecta" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=11;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="OLD_S10"><mxGeometry x="0.3211" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>
        <mxCell id="OLD_NDATOS" value="CONTRATO DE DATOS (ADR-006, enmienda)&#10;&#10;DatosProducto NO lleva Marca, Presentacion ni Categoria.&#10;Si los llevara, cada tipo nuevo obligaria a modificarlo y&#10;el sistema seguiria cerrado a la extension: seria el mismo&#10;defecto H-06 movido del cargador al DTO.&#10;&#10;Cada creador interpreta SUS columnas de Extra:&#10;   CreadorMedicamentoCapsula   [0] -&amp;gt; laboratorio&#10;   CreadorCosmetico            [0] -&amp;gt; Marca  [1] -&amp;gt; Presentacion&#10;   CreadorComestible           [0] -&amp;gt; Categoria&#10;&#10;Formato de productos.txt:&#10;   medicamento;Nombre;Precio;Stock;StockMinimo;Fecha;Laboratorio&#10;   cosmetico;Nombre;Precio;Stock;StockMinimo;Fecha;Marca;Presentacion&#10;   comestible;Nombre;Precio;Stock;StockMinimo;Fecha;Categoria&#10;&#10;Costo aceptado: Extra viaja sin interpretar. Es inevitable, porque&#10;solo el creador sabe que la columna 7 de un comestible es un enum.&#10;Agregar un tipo = 1 clase + 1 creador + 1 linea en Program. 0 modificadas." style="shape=note;whiteSpace=wrap;html=1;size=18;verticalAlign=top;align=left;fontSize=12;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="OLDLAYER"><mxGeometry x="5628.0" y="6756.4" width="720" height="426" as="geometry" /></mxCell>
        <mxCell id="OLD_NDATOS_e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;dashed=1;strokeWidth=2;strokeColor=#d6b656;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="OLDLAYER" source="OLD_NDATOS" target="OLD_DatosProducto"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5988" y="6736" /><mxPoint x="6135" y="6736" /><mxPoint x="6135" y="4894" /><mxPoint x="6668" y="4894" /></Array></mxGeometry></mxCell>
        <mxCell id="1" value="TO-BE Reto 2 (patrones nuevos, superpuesta)" parent="0" />
        <mxCell id="Program" value="«composition root»&#10;Program.cs" style="swimlane;html=1;whiteSpace=wrap;startSize=52;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="3737.9999999999995" y="2226.0" width="400" height="192.0" as="geometry" /></mxCell>
        <mxCell id="Program_a" value="Unico lugar que hace new de&#10;todo lo de abajo (AS-IS y TO-BE)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingLeft=6;fontFamily=Courier New;" vertex="1" parent="Program"><mxGeometry x="0" y="52" width="400" height="48" as="geometry" /></mxCell>
