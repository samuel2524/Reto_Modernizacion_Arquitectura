        </mxCell>
        
        <mxCell id="OLD_CargadorUsuariosTxt_a" parent="OLD_CargadorUsuariosTxt" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingLeft=6;fontFamily=Courier New;" value="" vertex="1">
