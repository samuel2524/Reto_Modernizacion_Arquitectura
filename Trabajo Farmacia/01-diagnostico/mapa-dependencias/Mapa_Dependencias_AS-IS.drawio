        <mxCell id="D23" edge="1" parent="1" source="ServicioNotificacion_a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;dashed=1;strokeWidth=2;strokeColor=#9673A6;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" target="IServicioNotificacion" value="">
          <mxGeometry relative="1" as="geometry">
