@startuml 01-vista-general-as-is
title UML-01: Vista general AS-IS

top to bottom direction
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 45
skinparam dpi 180
skinparam defaultFontSize 12

package "Espacio de nombres global" as Global {
  class Program <<UML-05>>
}

package "BibFarmacia.Interfaces" as Interfaces {
  interface IDescuento <<UML-03>>
  interface IServicioNotificacion <<UML-03>>
}

package "BibFarmacia.Servicios" as Servicios {
  class ServicioUsuario <<UML-03>>
  class ServicioProducto <<UML-03>>
  class ServicioCliente <<UML-03>>
  class ServicioMovimiento <<UML-03>>
  class ServicioDescuento <<UML-03>>
  class ServicioNotificacion <<UML-03>>
}

package "BibFarmacia.Clases" as Clases {
  abstract class Persona <<UML-02>>
  class Usuario <<UML-02>>
  class Cliente <<UML-02>>
  abstract class Producto <<UML-02>>
  class Medicamento <<UML-02>>
  class MedicamentoCapsula <<UML-02>>
  class MedicamentoLiquido <<UML-02>>
  class Laboratorio <<UML-02>>
  class Movimiento <<UML-02>>
}

package "BibFarmacia.Eventos" as Eventos {
  class EventoStockMinimo <<UML-04>>
  class EventoVencimiento <<UML-04>>
  class EventoPuntos <<UML-04>>
  class EventoMovimiento <<UML-04>>
}

package "BibFarmacia.Enum" as Enums {
  enum TipoRelleno <<UML-02>>
  enum MaterialEnvase <<UML-02>>
}

package "BibFarmacia.Factories" as Factories {
  class ProductoFactory <<estática, UML-05>>
}

package "BibFarmacia.Aspectos" as Aspectos {
  class AspectoAutenticacion <<estática, UML-05>>
  class AspectoValidacion <<estática, UML-05>>
}

' Herencias e implementaciones.
Usuario --|> Persona
Cliente --|> Persona
Medicamento --|> Producto
MedicamentoCapsula --|> Medicamento
MedicamentoLiquido --|> Medicamento
ServicioDescuento ..|> IDescuento
ServicioNotificacion ..|> IServicioNotificacion

' Asociaciones estructurales principales.
Medicamento --> Laboratorio
Movimiento --> Producto
ServicioUsuario --> Usuario
ServicioProducto --> Producto
ServicioCliente --> Cliente
ServicioMovimiento --> Movimiento
ServicioProducto --> EventoStockMinimo
ServicioProducto --> EventoVencimiento
ServicioCliente --> EventoPuntos
ServicioMovimiento --> EventoMovimiento

' Dependencias arquitectónicas principales.
Program ..> ServicioUsuario : <<instancia>>
Program ..> ServicioProducto : <<instancia>>
Program ..> ServicioCliente : <<instancia>>
Program ..> ServicioMovimiento : <<instancia>>
ProductoFactory ..> MedicamentoCapsula : <<crea>>
ProductoFactory ..> MedicamentoLiquido : <<crea>>
ServicioUsuario ..> AspectoAutenticacion : <<usa>>

' Guías invisibles de distribución.
Program -[hidden]down- ServicioProducto
ServicioUsuario -[hidden]right- ServicioProducto
ServicioProducto -[hidden]right- ServicioCliente
ServicioCliente -[hidden]right- ServicioMovimiento
ServicioDescuento -[hidden]right- ServicioNotificacion
EventoStockMinimo -[hidden]right- EventoVencimiento
EventoPuntos -[hidden]right- EventoMovimiento
Persona -[hidden]right- Producto
TipoRelleno -[hidden]right- MaterialEnvase
ProductoFactory -[hidden]right- AspectoAutenticacion

legend bottom
  |= Relación |= Significado |
  | Herencia | Una clase hereda de otra |
  | Implementación | Una clase implementa una interfaz |
  | Asociación estructural | Una clase mantiene una referencia a otra |
  | Dependencia | Una clase utiliza temporalmente a otra |
  | <<crea>> | Construcción directa de una instancia |
  | <<usa>> | Uso temporal de otra clase |
  | <<retorna>> | Un método retorna una instancia del tipo indicado |
  | <<publica>> | Una clase publica un evento |
  | <<dispara>> | Una clase provoca la ejecución de un evento |
  | <<se suscribe>> | Una clase escucha o se registra en un evento |
  | <<instancia>> | El punto de entrada construye un objeto |
  UML-02: Definición completa en UML-02: Dominio
  UML-03: Definición completa en UML-03: Servicios e interfaces
  UML-04: Definición completa en UML-04: Eventos
  UML-05: Definición completa en UML-05: Construcción y soporte
endlegend

@enduml
