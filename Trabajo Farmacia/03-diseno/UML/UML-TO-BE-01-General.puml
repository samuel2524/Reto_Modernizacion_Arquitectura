@startuml UML-TO-BE-01-General
!pragma layout smetana
title UML TO-BE 01 — Vista general, namespaces y trazabilidad

top to bottom direction
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 46
skinparam dpi 180
skinparam defaultFontSize 11

package "Espacio de nombres global" {
  class Program <<composition root, UML-02/03>> #D6EAF8
}

package "BibFarmacia.Interfaces" {
  interface ICargadorProductos <<ADR-002, DIP, ISP, UML-03>> #F5B7B1
  interface ICargadorClientes <<ADR-002, DIP, ISP, UML-03>> #F5B7B1
  interface ICargadorUsuarios <<ADR-002, DIP, ISP, UML-03>> #F5B7B1
  interface ICreadorProducto <<ADR-003, UML-03>> #D5F5E3
  interface IDescuento <<conservada, UML-02>> #E5E7EB
  interface IServicioNotificacion <<conservada, UML-02>> #E5E7EB
}

package "BibFarmacia.Servicios" {
  class ServicioVenta <<ADR-001, UML-02>> #D6EAF8
  class ServicioFidelizacion <<ADR-004, UML-02>> #D6EAF8
  class ServicioMonitoreoProductos <<ADR-005, UML-02/04>> #D6EAF8
  class ServicioProducto <<modificada, UML-02/03>> #F5B7B1
  class ServicioCliente <<modificada, UML-02/03>> #F5B7B1
  class ServicioUsuario <<modificada, UML-02/03>> #F5B7B1
  class ServicioMovimiento <<conservada, UML-02>> #E5E7EB
  class ServicioDescuento <<conservada, UML-02>> #E5E7EB
  class ServicioNotificacion <<conservada, UML-02>> #E5E7EB
  class CargadorProductosTxt <<ADR-002/003, UML-03>> #F5B7B1
  class CargadorClientesTxt <<ADR-002, UML-03>> #F5B7B1
  class CargadorUsuariosTxt <<ADR-002, UML-03>> #F5B7B1
}

package "BibFarmacia.Clases" {
  abstract class Persona <<conservada, UML-04>> #E5E7EB
  class Usuario <<conservada, UML-04>> #E5E7EB
  class Cliente <<conservada, UML-04>> #E5E7EB
  abstract class Producto <<conservada, UML-04>> #E5E7EB
  class Medicamento <<conservada, UML-04>> #E5E7EB
  class MedicamentoCapsula <<conservada, UML-04>> #E5E7EB
  class MedicamentoLiquido <<conservada, UML-04>> #E5E7EB
  class Laboratorio <<conservada, UML-04>> #E5E7EB
  class Movimiento <<conservada, UML-04>> #E5E7EB
  class DatosProducto <<ADR-003, UML-03>> #D5F5E3
}

package "BibFarmacia.Factories" {
  class ProductoFactory <<conservada, UML-04>> #E5E7EB
  class CreadorMedicamentoCapsula <<ADR-003, UML-03>> #D5F5E3
}

package "BibFarmacia.Eventos" {
  class EventoStockMinimo <<conservada, UML-04>> #E5E7EB
  class EventoVencimiento <<conservada, UML-04>> #E5E7EB
  class EventoPuntos <<conservada, UML-02>> #E5E7EB
  class EventoMovimiento <<conservada, UML-02>> #E5E7EB
}

package "BibFarmacia.Enum" {
  enum TipoRelleno <<conservada, UML-04>> #E5E7EB
  enum MaterialEnvase <<conservada, UML-04>> #E5E7EB
}

package "BibFarmacia.Aspectos" {
  class AspectoAutenticacion <<conservada, UML-04>> #E5E7EB
  class AspectoValidacion <<conservada, UML-04>> #E5E7EB
}

Program ..> ServicioVenta : <<crea>>
Program ..> ServicioFidelizacion : <<crea>>
Program ..> ServicioMonitoreoProductos : <<crea>>
Program ..> ServicioProducto : <<crea>>
Program ..> ServicioCliente : <<crea>>
Program ..> ServicioUsuario : <<crea>>
Program ..> ServicioMovimiento : <<crea>>
Program ..> CargadorProductosTxt : <<crea>>
Program ..> CargadorClientesTxt : <<crea>>
Program ..> CargadorUsuariosTxt : <<crea>>
Program ..> CreadorMedicamentoCapsula : <<crea>>

note right of Program
  Program actúa como Composition Root:
  crea implementaciones concretas y conecta las dependencias.
end note

ServicioProducto --> ICargadorProductos
ServicioCliente --> ICargadorClientes
ServicioUsuario --> ICargadorUsuarios
CargadorProductosTxt --> ICreadorProducto
ServicioVenta --> ServicioProducto
ServicioVenta --> ServicioMovimiento
ServicioFidelizacion ..> Cliente
ServicioMonitoreoProductos ..> Producto

note right of ProductoFactory
  Conservada; no participa en
  el flujo de creación ADR-003.
end note

legend bottom
  |= Color |= Significado |
  | <back:#E5E7EB>Gris</back> | AS-IS conservado |
  | <back:#D6EAF8>Azul</back> | SRP |
  | <back:#D5F5E3>Verde</back> | OCP |
  | <back:#FAD7A0>Naranja</back> | LSP, solo nota de verificación en UML-04 |
  | <back:#E8DAEF>Morado</back> | ISP cuando sea la motivación principal |
  | <back:#F5B7B1>Rojo</back> | DIP; ISP se agrega como estereotipo secundario |
  UML-02: casos de uso y servicios. UML-03: carga y adaptadores.
  UML-04: dominio, monitoreo y soporte conservado.
endlegend

@enduml
