        <mxCell id="N1" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=18;verticalAlign=top;align=left;fontSize=12;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" value="RIESGO SC-1 — arranque del sistema&#10;&#10;Program.cs L77-79 llama CargarDesdeArchivo&#10;al arrancar. Un error en el nuevo parseo&#10;rompe la carga de TODO el inventario, y con&#10;ella las alertas de stock y vencimiento&#10;(Program L137-139 -&amp;gt; ServicioProducto L47-73)." vertex="1">
          <mxGeometry height="166" width="430" x="590" y="360" as="geometry" />
        </mxCell>
        <mxCell id="N2" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=18;verticalAlign=top;align=left;fontSize=12;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" value="RIESGO SC-2 — conducta observable&#10;&#10;El flujo de venta es un switch compartido:&#10;stock y puntos conviven con el flujo nuevo.&#10;Cambia el mensaje del evento de movimiento&#10;y la regla de acumulacion de puntos." vertex="1">
          <mxGeometry height="146" width="430" x="2000" y="360" as="geometry" />
        </mxCell>
        <mxCell id="N3" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=18;verticalAlign=top;align=left;fontSize=12;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" value="RIESGO SC-3 — salida visible&#10;&#10;Hoy la venta muestra el precio SIN descuento.&#10;Agregar una linea de descuento cambia la&#10;salida observable, que la restriccion dura&#10;del reto prohibe alterar." vertex="1">
          <mxGeometry height="146" width="430" x="3410" y="360" as="geometry" />
        </mxCell>
        <mxCell id="N4" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=18;verticalAlign=top;align=left;fontSize=12;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" value="LECTURA DEL MAPA (metrica &quot;antes&quot;, criterio 5)&#10;&#10;Ninguna de las tres solicitudes se implementa hoy solo AGREGANDO codigo:&#10;las tres obligan a MODIFICAR clases existentes (en rojo punteado).&#10;&#10;Program y ServicioCliente reciben flecha de DOS solicitudes distintas:&#10;un mismo archivo se toca por motivos que no tienen nada que ver entre si.&#10;Eso es la violacion de OCP que el reto pide demostrar con metrica, y el&#10;sintoma de los hallazgos H-02, H-03, H-06 y H-07 del diagnostico AS-IS.&#10;&#10;En el TO-BE (Fase 3) esta misma tabla debe quedar en 0 clases modificadas." vertex="1">
          <mxGeometry height="246" width="430" x="1940" y="1980" as="geometry" />
        </mxCell>
        <mxCell id="TITULO" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" value="SolucionFarmacia — Fase 2: mapa de impacto de las solicitudes de cambio&#10;Medicion sobre el codigo actual (BibFarmacia + AppFarmaciaConsola) · columna &quot;antes&quot; de la metrica de extensibilidad&#10;Reto de Modernizacion Arquitectonica SOLID" vertex="1">
          <mxGeometry height="100" width="1500" x="60" y="40" as="geometry" />
        </mxCell>
