@startuml UML-TO-BE-02-Casos-Uso-Servicios
!pragma layout smetana
title UML TO-BE 02 — Casos de uso, servicios y eventos

left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 34
skinparam ranksep 48
skinparam dpi 180
skinparam defaultFontSize 11

package "Espacio de nombres global" {
  class Program <<programa de nivel superior, composition root>> #D6EAF8 {
    - {static} <Main>$(args: string[]): void
  }
}

package "BibFarmacia.Servicios" {
  class ServicioVenta <<ADR-001>> #D6EAF8 {
    - servicioProducto: ServicioProducto {solo lectura}
    - servicioMovimiento: ServicioMovimiento {solo lectura}
    + ServicioVenta(servicioProducto: ServicioProducto,\n  servicioMovimiento: ServicioMovimiento)
    + BuscarProducto(nombre: string): Producto?
    + Vender(producto: Producto, cantidad: int): string
  }

  class ServicioFidelizacion <<ADR-004>> #D6EAF8 {
    + EventoPuntos: EventoPuntos
    + ServicioFidelizacion()
    + AcumularPuntos(cliente: Cliente, puntos: int): void
  }

  class ServicioMonitoreoProductos <<ADR-005, resumen UML-04>> #D6EAF8 {
    + EventoStock: EventoStockMinimo
    + EventoVencimiento: EventoVencimiento
    + ServicioMonitoreoProductos()
    + VerificarStock(productos: IEnumerable<Producto>): void
    + VerificarVencimiento(productos: IEnumerable<Producto>): void
  }

  class ServicioProducto <<ADR-002/005>> #F5B7B1 {
    - productos: List<Producto> {solo lectura}
    - cargador: ICargadorProductos {solo lectura}
    + ServicioProducto(cargador: ICargadorProductos)
    + AgregarProducto(producto: Producto): string
    + ObtenerProductos(): List<Producto>
    + CargarDesdeArchivo(ruta: string): string
  }

  class ServicioCliente <<ADR-002/004>> #F5B7B1 {
    - clientes: List<Cliente>
    - cargador: ICargadorClientes {solo lectura}
    + ServicioCliente(cargador: ICargadorClientes)
    + AgregarCliente(cliente: Cliente): void
    + ObtenerClientes(): List<Cliente>
    + Cargar(ruta: string): string
  }

  class ServicioUsuario <<ADR-002>> #F5B7B1 {
    - usuarios: List<Usuario>
    - cargador: ICargadorUsuarios {solo lectura}
    + ServicioUsuario(cargador: ICargadorUsuarios)
    + AgregarUsuario(usuario: Usuario): void
    + Login(user: string, password: string): bool
    + Cargar(ruta: string): string
  }

  class ServicioMovimiento <<conservada>> #E5E7EB {
    - movimientos: List<Movimiento>
    + EventoMovimiento: EventoMovimiento
    + ServicioMovimiento()
    + RegistrarMovimiento(movimiento: Movimiento): void
    + ObtenerMovimientos(): List<Movimiento>
  }

  class ServicioDescuento <<conservada, no consumida>> #E5E7EB {
    + ServicioDescuento() <<implícito>>
    + CalcularDescuento(precio: decimal): decimal
  }

  class ServicioNotificacion <<conservada, no consumida>> #E5E7EB {
    + ServicioNotificacion() <<implícito>>
    + EnviarNotificacion(mensaje: string): void
  }
}

package "BibFarmacia.Interfaces" {
  interface IDescuento <<conservada>> #E5E7EB {
    + CalcularDescuento(precio: decimal): decimal
  }
  interface IServicioNotificacion <<conservada>> #E5E7EB {
    + EnviarNotificacion(mensaje: string): void
  }
  interface ICargadorProductos <<ADR-002, DIP, ISP, resumen UML-03>> #F5B7B1
  interface ICargadorClientes <<ADR-002, DIP, ISP, resumen UML-03>> #F5B7B1
  interface ICargadorUsuarios <<ADR-002, DIP, ISP, resumen UML-03>> #F5B7B1
}

package "BibFarmacia.Eventos" {
  class EventoPuntos <<conservada>> #E5E7EB {
    + PuntosAcumulados: DelegadoPuntos? <<evento>>
    + EventoPuntos() <<implícito>>
    + Disparar(cliente: string, puntos: int): void
  }
  class "EventoPuntos.DelegadoPuntos" as DelegadoPuntos <<delegado anidado>> #E5E7EB {
    + Invoke(mensaje: string): void {generado}
  }
  class EventoMovimiento <<conservada>> #E5E7EB {
    + MovimientoRegistrado: DelegadoMovimiento? <<evento>>
    + EventoMovimiento() <<implícito>>
    + Disparar(tipo: string): void
  }
  class "EventoMovimiento.DelegadoMovimiento" as DelegadoMovimiento <<delegado anidado>> #E5E7EB {
    + Invoke(mensaje: string): void {generado}
  }
  class EventoStockMinimo <<resumen UML-04>> #E5E7EB
  class EventoVencimiento <<resumen UML-04>> #E5E7EB
}

package "BibFarmacia.Clases" {
  abstract class Producto <<referencia; detalle UML-04>> #E5E7EB
  class Cliente <<referencia; detalle UML-04>> #E5E7EB
  class Usuario <<referencia; detalle UML-04>> #E5E7EB
  class Movimiento <<referencia; detalle UML-04>> #E5E7EB
}

ServicioDescuento ..|> IDescuento
ServicioNotificacion ..|> IServicioNotificacion
ServicioProducto --> "1" ICargadorProductos : <<inyecta>>
ServicioCliente --> "1" ICargadorClientes : <<inyecta>>
ServicioUsuario --> "1" ICargadorUsuarios : <<inyecta>>
ServicioProducto --> "0..*" Producto : <<mantiene>>
ServicioCliente --> "0..*" Cliente : <<mantiene>>
ServicioUsuario --> "0..*" Usuario : <<mantiene>>
ServicioMovimiento --> "0..*" Movimiento : <<mantiene>>

ServicioVenta --> "1" ServicioProducto
ServicioVenta --> "1" ServicioMovimiento
ServicioVenta ..> Producto : <<busca/modifica>>
ServicioVenta ..> Movimiento : <<crea>>
ServicioFidelizacion --> "1" EventoPuntos
ServicioFidelizacion ..> Cliente : <<AcumularPuntos>>
ServicioMonitoreoProductos --> "1" EventoStockMinimo
ServicioMonitoreoProductos --> "1" EventoVencimiento
ServicioMonitoreoProductos ..> Producto : <<recibe 0..*>>
ServicioMovimiento --> "1" EventoMovimiento
EventoPuntos ..> DelegadoPuntos : <<publica>>
EventoMovimiento ..> DelegadoMovimiento : <<publica>>

Program ..> ServicioVenta : <<crea/invoca>>
Program ..> ServicioFidelizacion : <<crea/invoca>>
Program ..> ServicioMonitoreoProductos : <<crea/invoca>>
Program ..> ServicioProducto : <<crea/consulta>>
Program ..> ServicioCliente : <<crea/consulta>>
Program ..> ServicioUsuario : <<crea/invoca>>
Program ..> ServicioMovimiento : <<crea>>
Program ..> EventoPuntos : <<se suscribe>>
Program ..> EventoMovimiento : <<se suscribe>>
Program ..> EventoStockMinimo : <<se suscribe>>
Program ..> EventoVencimiento : <<se suscribe>>

note right of Program
  Program actúa como Composition Root:
  crea implementaciones concretas y conecta las dependencias.
end note

note bottom of ServicioVenta
  BuscarProducto preserva coincidencia parcial y primer resultado.
  Program solicita y convierte cantidad después de encontrar producto;
  Vender preserva stock, fecha, Movimiento y mensajes observables.
end note

legend bottom
  |= Color |= Significado |
  | <back:#E5E7EB>Gris</back> | AS-IS conservado |
  | <back:#D6EAF8>Azul</back> | SRP: venta, fidelización y monitoreo separados |
  | <back:#D5F5E3>Verde</back> | OCP |
  | <back:#FAD7A0>Naranja</back> | LSP: reservado para nota UML-04 |
  | <back:#E8DAEF>Morado</back> | ISP cuando sea la motivación principal |
  | <back:#F5B7B1>Rojo</back> | DIP: servicios dependen de contratos; ISP es secundario |
  Asociaciones 1: colaborador o evento mantenido. 0..*: colección en memoria.
  Dependencia punteada: uso temporal, creación, invocación o suscripción.
endlegend

@enduml
