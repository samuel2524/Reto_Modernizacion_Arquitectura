        <mxCell id="CargadorUsuariosTxt_m" parent="CargadorUsuariosTxt" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingLeft=6;fontFamily=Courier New;" value="+ Cargar(ruta, destino): string&#xa;Concentra File y el formato TXT" vertex="1">
