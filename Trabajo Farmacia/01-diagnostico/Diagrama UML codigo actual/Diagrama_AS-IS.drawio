        <mxCell id="NH01" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=18;verticalAlign=top;align=left;fontSize=12;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" value="Program (H-01)&#xa;&#xa;La consola busca el producto,&#xa;modifica directamente el stock,&#xa;construye el movimiento y registra&#xa;la venta. Interfaz de Usuario&#xa;y reglas de negocio están mezcladas&#xa;(flujo de venta, líneas 255-303)." vertex="1">
          <mxGeometry height="148" width="260" x="2670" y="1420" as="geometry" />
        </mxCell>
        <mxCell id="NH02" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=18;verticalAlign=top;align=left;fontSize=12;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" value="ServicioProducto (H-02)&#xa;&#xa;CargarDesdeArchivo solo&#xa;carga un tipo de medicamento&#xa;y tipo de rellenos; no se pueden&#xa;cargar otros tipos (líneas 93-109)." vertex="1">
          <mxGeometry height="105" width="200" x="3240" y="2523" as="geometry" />
        </mxCell>
        <mxCell id="NH05" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=18;verticalAlign=top;align=left;fontSize=12;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" value="ServicioProducto (H-05)&#xa;&#xa;ServicioProducto concentra&#xa;la administración de la colección&#xa;de productos y la evaluación de&#xa;condiciones de stock y vencimiento&#xa;para generar alertas (líneas 27-120)." vertex="1">
          <mxGeometry height="138" width="220" x="3280" y="2670" as="geometry" />
        </mxCell>
        <mxCell id="NH03" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=18;verticalAlign=top;align=left;fontSize=12;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" value="ServicioCliente (H-03)&#xa;&#xa;La clase maneja clientes,&#xa;acumula puntos y carga clientes.&#xa;Hay 2 responsabilidades diferentes&#xa;(líneas 14-80)." vertex="1">
          <mxGeometry height="114" width="240" x="1400" y="1250" as="geometry" />
