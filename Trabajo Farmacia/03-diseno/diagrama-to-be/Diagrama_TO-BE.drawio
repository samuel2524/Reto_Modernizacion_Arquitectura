        <mxCell id="CargadorUsuariosTxt" parent="1" style="swimlane;html=1;whiteSpace=wrap;startSize=52;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#7030A0;strokeWidth=3;swimlaneFillColor=#ffffff;" value="«nuevo»&#xa;CargadorUsuariosTxt" vertex="1">
