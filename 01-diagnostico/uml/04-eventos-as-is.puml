@startuml 04-eventos-as-is
title UML-04: Eventos y delegados AS-IS

top to bottom direction
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 36
skinparam ranksep 54
skinparam dpi 180
skinparam defaultFontSize 12

package "BibFarmacia.Eventos" as Eventos {
  class EventoStockMinimo {
    + StockMinimo: DelegadoStock? <<evento>>
    + EventoStockMinimo() <<implícito>>
    + Disparar(producto: Producto): void
  }

  class "EventoStockMinimo.DelegadoStock" as DelegadoStock <<delegado anidado>> {
    + Invoke(mensaje: string): void {generado}
  }

  class EventoVencimiento {
    + Vencimiento: DelegadoVencimiento? <<evento>>
    + EventoVencimiento() <<implícito>>
    + Disparar(producto: Producto): void
  }

  class "EventoVencimiento.DelegadoVencimiento" as DelegadoVencimiento <<delegado anidado>> {
    + Invoke(mensaje: string): void {generado}
  }

  class EventoPuntos {
    + PuntosAcumulados: DelegadoPuntos? <<evento>>
    + EventoPuntos() <<implícito>>
    + Disparar(cliente: string, puntos: int): void
  }

  class "EventoPuntos.DelegadoPuntos" as DelegadoPuntos <<delegado anidado>> {
    + Invoke(mensaje: string): void {generado}
  }

  class EventoMovimiento {
    + MovimientoRegistrado: DelegadoMovimiento? <<evento>>
    + EventoMovimiento() <<implícito>>
    + Disparar(tipo: string): void
  }

  class "EventoMovimiento.DelegadoMovimiento" as DelegadoMovimiento <<delegado anidado>> {
    + Invoke(mensaje: string): void {generado}
  }
}

package "BibFarmacia.Servicios (resumen)" as Servicios {
  class ServicioProducto <<UML-03>>
  class ServicioCliente <<UML-03>>
  class ServicioMovimiento <<UML-03>>
}

package "BibFarmacia.Clases (resumen)" as Clases {
  abstract class Producto <<UML-02>>
}

package "Espacio de nombres global (resumen)" as Global {
  class Program <<UML-05>>
}

EventoStockMinimo ..> DelegadoStock : <<publica>>
EventoVencimiento ..> DelegadoVencimiento : <<publica>>
EventoPuntos ..> DelegadoPuntos : <<publica>>
EventoMovimiento ..> DelegadoMovimiento : <<publica>>

ServicioProducto ..> EventoStockMinimo : <<dispara>>
ServicioProducto ..> EventoVencimiento : <<dispara>>
ServicioCliente ..> EventoPuntos : <<dispara>>
ServicioMovimiento ..> EventoMovimiento : <<dispara>>

Program ..> EventoStockMinimo : <<se suscribe>>
Program ..> EventoVencimiento : <<se suscribe>>
Program ..> EventoPuntos : <<se suscribe>>
Program ..> EventoMovimiento : <<se suscribe>>

EventoStockMinimo ..> Producto : <<usa>>
EventoVencimiento ..> Producto : <<usa>>

' Guías invisibles de distribución.
ServicioProducto -[hidden]right- ServicioCliente
ServicioCliente -[hidden]right- ServicioMovimiento
EventoStockMinimo -[hidden]right- EventoVencimiento
EventoPuntos -[hidden]right- EventoMovimiento
DelegadoStock -[hidden]right- DelegadoVencimiento
DelegadoPuntos -[hidden]right- DelegadoMovimiento

legend bottom
  |= Relación |= Significado |
  | Herencia | Una clase hereda de otra |
  | Implementación | Una clase implementa una interfaz |
  | Asociación estructural | Una clase mantiene una referencia a otra |
  | Dependencia | Una clase utiliza temporalmente a otra |
  | <<crea>> | Construcción directa de una instancia |
  | <<usa>> | Uso temporal de otra clase |
  | <<retorna>> | Un método retorna una instancia del tipo indicado |
  | <<publica>> | Una clase publica un evento |
  | <<dispara>> | Una clase provoca la ejecución de un evento |
  | <<se suscribe>> | Una clase escucha o se registra en un evento |
  | <<instancia>> | El punto de entrada construye un objeto |
  UML-02: Definición completa en UML-02: Dominio
  UML-03: Definición completa en UML-03: Servicios e interfaces
  UML-05: Definición completa en UML-05: Construcción y soporte
endlegend

@enduml
