        <mxCell id="D23" edge="1" parent="1" source="ServicioNotificacion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;dashed=1;strokeWidth=2;strokeColor=#9673A6;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" target="IServicioNotificacion" value="">
