@startuml UML-TO-BE-04-Dominio-Monitoreo
!pragma layout smetana
title UML TO-BE 04 — Dominio conservado, monitoreo y verificación LSP

top to bottom direction
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 34
skinparam ranksep 50
skinparam dpi 180
skinparam defaultFontSize 11

package "BibFarmacia.Clases" {
  abstract class Persona #E5E7EB {
    + Nombre: string { get; set; }
    + Cedula: string { get; set; }
    + Telefono: string { get; set; }
    + Correo: string { get; set; }
    # Persona(nombre: string, cedula: string,\n  telefono: string, correo: string)
  }
  class Usuario #E5E7EB {
    + UserName: string { get; set; }
    + Password: string { get; set; }
    + Usuario(nombre: string, cedula: string, telefono: string,\n  correo: string, userName: string, password: string)
  }
  class Cliente #E5E7EB {
    + Puntos: int { get; set; }
    + Cliente(nombre: string, cedula: string,\n  telefono: string, correo: string)
    + AcumularPuntos(puntos: int): void
  }

  abstract class Producto #E5E7EB {
    + Nombre: string { get; set; }
    + Precio: decimal { get; set; }
    + Stock: int { get; set; }
    + StockMinimo: int { get; set; }
    + FechaVencimiento: DateTime { get; set; }
    # Producto(nombre: string, precio: decimal, stock: int,\n  stockMinimo: int, fechaVencimiento: DateTime)
    + MostrarInformacion(): void {virtual}
  }
  class Medicamento #E5E7EB {
    + Laboratorio: Laboratorio { get; set; }
    + Medicamento(nombre: string, precio: decimal, stock: int,\n  stockMinimo: int, fechaVencimiento: DateTime,\n  laboratorio: Laboratorio)
  }
  class MedicamentoCapsula #E5E7EB {
    + TipoRelleno: TipoRelleno { get; set; }
    + MedicamentoCapsula(nombre: string, precio: decimal, stock: int,\n  stockMinimo: int, fechaVencimiento: DateTime,\n  laboratorio: Laboratorio, tipoRelleno: TipoRelleno)
  }
  class MedicamentoLiquido #E5E7EB {
    + MaterialEnvase: MaterialEnvase { get; set; }
    + Mililitros: int { get; set; }
    + MedicamentoLiquido(nombre: string, precio: decimal, stock: int,\n  stockMinimo: int, fechaVencimiento: DateTime,\n  laboratorio: Laboratorio, materialEnvase: MaterialEnvase,\n  mililitros: int)
  }
  class Laboratorio #E5E7EB {
    + Nombre: string { get; set; }
    + Direccion: string { get; set; }
    + Telefono: string { get; set; }
    + Laboratorio(nombre: string, direccion: string, telefono: string)
  }
  class Movimiento #E5E7EB {
    + Fecha: DateTime { get; set; }
    + Cantidad: int { get; set; }
    + Tipo: string { get; set; }
    + Producto: Producto { get; set; }
    + Movimiento(fecha: DateTime, cantidad: int,\n  tipo: string, producto: Producto)
  }
}

package "BibFarmacia.Enum" {
  enum TipoRelleno #E5E7EB {
    Gel = 0
    Polvo = 1
  }
  enum MaterialEnvase #E5E7EB {
    Vidrio = 0
    Plastico = 1
  }
}

package "BibFarmacia.Servicios" {
  class ServicioMonitoreoProductos <<ADR-005>> #D6EAF8 {
    + EventoStock: EventoStockMinimo
    + EventoVencimiento: EventoVencimiento
    + ServicioMonitoreoProductos()
    + VerificarStock(productos: IEnumerable<Producto>): void
    + VerificarVencimiento(productos: IEnumerable<Producto>): void
  }
}

package "BibFarmacia.Eventos" {
  class EventoStockMinimo #E5E7EB {
    + StockMinimo: DelegadoStock? <<evento>>
    + EventoStockMinimo() <<implícito>>
    + Disparar(producto: Producto): void
  }
  class "EventoStockMinimo.DelegadoStock" as DelegadoStock <<delegado anidado>> #E5E7EB {
    + Invoke(mensaje: string): void {generado}
  }
  class EventoVencimiento #E5E7EB {
    + Vencimiento: DelegadoVencimiento? <<evento>>
    + EventoVencimiento() <<implícito>>
    + Disparar(producto: Producto): void
  }
  class "EventoVencimiento.DelegadoVencimiento" as DelegadoVencimiento <<delegado anidado>> #E5E7EB {
    + Invoke(mensaje: string): void {generado}
  }
}

package "BibFarmacia.Factories" {
  class ProductoFactory <<estática>> #E5E7EB {
    + {static} CrearCapsula(nombre: string, precio: decimal, stock: int,\n  laboratorio: Laboratorio): MedicamentoCapsula
    + {static} CrearLiquido(nombre: string, precio: decimal, stock: int,\n  laboratorio: Laboratorio): MedicamentoLiquido
  }
}

package "BibFarmacia.Aspectos" {
  class AspectoAutenticacion <<estática>> #E5E7EB {
    + {static} Login(usuarios: List<Usuario>, user: string,\n  password: string): bool
  }
  class AspectoValidacion <<estática>> #E5E7EB {
    + {static} ValidarCliente(cliente: Cliente): string
    + {static} ValidarProducto(producto: Producto): string
  }
}

Usuario --|> Persona
Cliente --|> Persona
Medicamento --|> Producto
MedicamentoCapsula --|> Medicamento
MedicamentoLiquido --|> Medicamento
Medicamento --> "1" Laboratorio
Movimiento --> "1" Producto
MedicamentoCapsula ..> TipoRelleno : <<usa>>
MedicamentoLiquido ..> MaterialEnvase : <<usa>>

ServicioMonitoreoProductos --> "1" EventoStockMinimo
ServicioMonitoreoProductos --> "1" EventoVencimiento
ServicioMonitoreoProductos ..> Producto : <<recibe 0..*>>
EventoStockMinimo ..> DelegadoStock : <<publica>>
EventoVencimiento ..> DelegadoVencimiento : <<publica>>
EventoStockMinimo ..> Producto : <<usa>>
EventoVencimiento ..> Producto : <<usa>>

ProductoFactory ..> MedicamentoCapsula : <<crea>>
ProductoFactory ..> MedicamentoLiquido : <<crea>>
ProductoFactory ..> Laboratorio : <<usa>>
AspectoAutenticacion ..> Usuario : <<usa>>
AspectoValidacion ..> Cliente : <<usa>>
AspectoValidacion ..> Producto : <<usa>>

note as NotaLsp #FAD7A0
  Verificación LSP: el monitor recibe Producto y no realiza downcasts.
  Medicamento, MedicamentoCapsula y MedicamentoLiquido heredan legítimamente
  Stock, StockMinimo y FechaVencimiento. Ejecutar el mismo contrato de
  monitoreo para cada subtipo. Matriz completa: Validacion-UML-TO-BE.md.
end note
NotaLsp .. Producto

note right of ProductoFactory
  Conservada. No participa en el flujo ADR-003.
end note

legend bottom
  |= Color |= Significado |
  | <back:#E5E7EB>Gris</back> | Dominio y soporte AS-IS conservados |
  | <back:#D6EAF8>Azul</back> | SRP: monitoreo separado del catálogo |
  | <back:#D5F5E3>Verde</back> | OCP |
  | <back:#FAD7A0>Naranja</back> | Nota compacta de verificación LSP |
  | <back:#E8DAEF>Morado</back> | ISP |
  | <back:#F5B7B1>Rojo</back> | DIP |
  La jerarquía conservada permanece gris; naranja no denota tipos nuevos.
  Asociación 1: referencia estructural obligatoria. Dependencia: uso temporal.
endlegend

@enduml
